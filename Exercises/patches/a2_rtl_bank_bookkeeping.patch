diff --git a/hw/rtl/cache/VX_cache_bank.sv b/hw/rtl/cache/VX_cache_bank.sv
--- a/hw/rtl/cache/VX_cache_bank.sv
+++ b/hw/rtl/cache/VX_cache_bank.sv
@@ -50,6 +50,9 @@ module VX_cache_bank import VX_gpu_pkg::*; #(
     output wire perf_write_miss,
     output wire perf_evictions,
     output wire perf_mshr_stall,
+    output wire perf_pf_req,
+    output wire perf_pf_unused,
+    output wire perf_pf_late,
 `endif
 
     // Core request
@@ -1300,6 +1303,81 @@ module VX_cache_bank import VX_gpu_pkg::*; #(
     assign perf_write_miss = do_write_st1 && ~st1.lk.is_hit;
     assign perf_evictions  = do_writeback_stc;
     assign perf_mshr_stall = mshr_alm_full;
+
+    // ========================================================================
+    // Software-prefetch bookkeeping (perf only, no effect on the datapath)
+    //
+    // Per line/way: installed by a prefetch, and touched by a demand access
+    // since. Per MSHR entry: the entry's own prefetch bit, the root of the
+    // chain it belongs to, and whether a demand access has joined that chain.
+    // A fill (keyed by its root id) installs the line with those two bits, so
+    // chain members completed by the fill-forward port count as a use.
+    // ========================================================================
+    reg [NUM_WAYS-1:0] pf_line_r   [`CS_LINES_PER_BANK];
+    reg [NUM_WAYS-1:0] used_line_r [`CS_LINES_PER_BANK];
+    reg [MSHR_SIZE-1:0] pf_own_r, pf_joined_r;
+    reg [MSHR_ADDR_WIDTH-1:0] pf_root_r [MSHR_SIZE];
+    reg pf_fill_st0, used_fill_st0;
+
+    wire pf_st0 = st0.req.attr[MEM_ATTR_PREFETCH_OFFS];
+    wire pf_st1 = st1.req.attr[MEM_ATTR_PREFETCH_OFFS];
+    wire pf_stc = stC.req.attr[MEM_ATTR_PREFETCH_OFFS];
+    wire [MSHR_ADDR_WIDTH-1:0] pf_prev_root_st1 = pf_root_r[st1.lk.mshr_previd];
+    // an entry kept at S1 is a miss: a new chain root, or a link behind previd
+    wire mshr_keep_st1 = mshr_finalize_st1 && ~mshr_release_st1 && ~pipe_stall;
+    wire pf_install_st0 = do_fill_st0 && ~st0.req.is_passthru_fill && ~pipe_stall;
+    wire [NUM_WAYS-1:0] flush_way_oh_st0 = NUM_WAYS'(1'b1) << st0.req.way_idx;
+
+    always @(posedge clk) begin
+        if (~pipe_stall) begin
+            pf_fill_st0   <= pf_own_r[mem_rsp_id];
+            used_fill_st0 <= pf_joined_r[mem_rsp_id];
+        end
+        if (mshr_keep_st1) begin
+            pf_own_r[st1.req.mshr_id] <= pf_st1;
+            if (st1.lk.mshr_pending) begin
+                pf_root_r[st1.req.mshr_id] <= pf_prev_root_st1;
+                if (~pf_st1) begin
+                    pf_joined_r[pf_prev_root_st1] <= 1'b1;
+                end
+            end else begin
+                pf_root_r[st1.req.mshr_id]   <= st1.req.mshr_id;
+                pf_joined_r[st1.req.mshr_id] <= 1'b0;
+            end
+        end
+        // a write-through flush clears every way of the line in one pass; a
+        // write-back flush walks (line, way) pairs.
+        if (do_init_st0 || (do_flush_st0 && !WRITEBACK && ~pipe_stall)) begin
+            pf_line_r[line_idx_st0]   <= '0;
+            used_line_r[line_idx_st0] <= '0;
+        end else if (do_flush_st0 && ~pipe_stall) begin
+            pf_line_r[line_idx_st0]   <= pf_line_r[line_idx_st0] & ~flush_way_oh_st0;
+            used_line_r[line_idx_st0] <= used_line_r[line_idx_st0] & ~flush_way_oh_st0;
+        end
+        if (pf_install_st0) begin
+            pf_line_r[line_idx_st0]   <= (pf_line_r[line_idx_st0] & ~fill_way_oh_st0) | (fill_way_oh_st0 & {NUM_WAYS{pf_fill_st0}});
+            used_line_r[line_idx_st0] <= (used_line_r[line_idx_st0] & ~fill_way_oh_st0) | (fill_way_oh_st0 & {NUM_WAYS{used_fill_st0}});
+        end
+        if (do_lookup_st0 && lk_st0.is_hit && ~pf_st0 && ~pipe_stall) begin
+            used_line_r[line_idx_st0] <= used_line_r[line_idx_st0] | tag_matches_st0;
+        end
+    end
+
+    // TODO (assignment 2, Part B): replace the three constants below with the
+    // prefetch events, each a one-cycle pulse (the cache pop-counts them across
+    // banks every cycle):
+    //   pf_fill_req_stc: a prefetch read leaves the commit stage as a miss that
+    //                    issues a new fill (not a hit, not chained to a pending MSHR)
+    //   pf_victim_st0  : a fill installs over a way that a prefetch filled and no
+    //                    demand access has hit since
+    //   pf_late_st1    : a demand miss is linked behind a chain whose root is a prefetch
+    wire pf_fill_req_stc = 1'b0;
+    wire pf_victim_st0   = 1'b0;
+    wire pf_late_st1     = 1'b0;
+
+    assign perf_pf_req    = pf_fill_req_stc;
+    assign perf_pf_unused = pf_victim_st0;
+    assign perf_pf_late   = pf_late_st1;
 `endif
 
