diff --git a/tests/regression/neural_tex/Makefile b/tests/regression/neural_tex/Makefile
new file mode 100644
index 0000000..5e1e2fa
--- /dev/null
+++ b/tests/regression/neural_tex/Makefile
@@ -0,0 +1,31 @@
+ROOT_DIR := $(realpath ../../..)
+include $(ROOT_DIR)/config.mk
+
+# The TCU is always in the hardware config so the scalar baseline (SCALAR=1)
+# runs on the same machine as the tensor-core path.
+CONFIGS := $(if $(findstring -DVX_CFG_EXT_TCU_ENABLE,$(CONFIGS)),$(CONFIGS),$(CONFIGS) -DVX_CFG_EXT_TCU_ENABLE)
+
+PROJECT := neural_tex
+
+SRC_DIR := $(VORTEX_HOME)/tests/regression/$(PROJECT)
+
+SRCS := $(SRC_DIR)/main.cpp
+
+VX_SRCS := $(SRC_DIR)/kernel.cpp
+
+# WEIGHTS=neural_tex_weights_h32.h selects another trained header (hidden 32).
+ifneq ($(WEIGHTS),)
+VX_CFLAGS += -DNEURAL_TEX_WEIGHTS_H='"$(WEIGHTS)"'
+CXXFLAGS  += -DNEURAL_TEX_WEIGHTS_H='"$(WEIGHTS)"'
+endif
+
+ifeq ($(SCALAR),1)
+VX_CFLAGS += -DNEURAL_TEX_SCALAR
+CXXFLAGS  += -DNEURAL_TEX_SCALAR
+endif
+
+OPTS ?= -w 64 -h 64
+
+KERNEL_LIB := vortex2
+
+include ../common.mk
