diff --git a/tests/regression/neural_tex/common.h b/tests/regression/neural_tex/common.h
new file mode 100644
index 0000000..09a2f25
--- /dev/null
+++ b/tests/regression/neural_tex/common.h
@@ -0,0 +1,21 @@
+#ifndef _COMMON_H_
+#define _COMMON_H_
+
+#include <stdint.h>
+
+#ifndef VX_CFG_NUM_THREADS
+#define VX_CFG_NUM_THREADS 4
+#endif
+
+// Weights: NEURAL_TEX_SCALAR -> fp32 row-major [K][N]; TCU -> fp16 B^T [N][K].
+// Biases are always fp32[N]. dst is RGBA8, one word per pixel.
+typedef struct {
+  uint32_t width;
+  uint32_t height;
+  uint64_t w0_addr, b0_addr;
+  uint64_t w1_addr, b1_addr;
+  uint64_t w2_addr, b2_addr;
+  uint64_t dst_addr;
+} kernel_arg_t;
+
+#endif
diff --git a/tests/regression/neural_tex/kernel.cpp b/tests/regression/neural_tex/kernel.cpp
new file mode 100644
index 0000000..e32e829
--- /dev/null
+++ b/tests/regression/neural_tex/kernel.cpp
@@ -0,0 +1,132 @@
+// Neural texture decoder: a 16 -> H -> H -> 3 MLP on Fourier features of
+// (u,v) replaces the texture lookup. One warp decodes TILE_M pixels at a time:
+// the pixel rows are the M dimension of the TCU matmul, the layer width is N
+// and the input width is K. Activations/weights are bf16 (fp16 with
+// -DNEURAL_TEX_FP16), accumulation fp32. Build with SCALAR=1 for the plain-FMA
+// baseline.
+#include "common.h"
+#include "neural_tex_math.h"
+#ifndef NEURAL_TEX_WEIGHTS_H
+#define NEURAL_TEX_WEIGHTS_H "neural_tex_weights.h"
+#endif
+#include NEURAL_TEX_WEIGHTS_H
+#include <vx_spawn2.h>
+#include <vx_intrinsics.h>
+
+#ifndef NEURAL_TEX_SCALAR
+#include <vx_tensor.h>
+namespace vt = vortex::tensor;
+using ctx = vt::wmma_context<VX_CFG_NUM_THREADS, vt::NT_ITYPE, vt::fp32>;
+static constexpr uint32_t TILE_M = ctx::tileM;
+static_assert(NT_L0_K % ctx::tileK == 0, "layer-0 input width must be a multiple of tileK");
+static_assert(NT_L1_K % ctx::tileK == 0, "hidden width must be a multiple of tileK");
+static_assert(NT_L0_N % ctx::tileN == 0 && NT_L1_N % ctx::tileN == 0 && NT_L2_N % ctx::tileN == 0,
+              "layer widths must be a multiple of tileN");
+#else
+static constexpr uint32_t TILE_M = VX_CFG_NUM_THREADS;
+#endif
+
+static constexpr uint32_t NFEAT = NT_L0_K;
+static_assert(NFEAT == NT_NFEAT, "feature width mismatch");
+
+static inline uint32_t pack_rgba8(float r, float g, float b) {
+  auto q = [](float x) -> uint32_t {
+    x = x < 0.0f ? 0.0f : (x > 1.0f ? 1.0f : x);
+    return (uint32_t)(x * 255.0f + 0.5f);
+  };
+  return q(r) | (q(g) << 8) | (q(b) << 16) | 0xff000000u;
+}
+
+#ifndef NEURAL_TEX_SCALAR
+
+// out[M x N] = relu?(in[M x K] * W[K x N] + bias[N]) on the TCU.
+//   in   : fp16 row-major in local memory, ldm = K
+//   wt   : fp16 B^T row-major [N][K] in global memory (sgemm_tcu's B layout)
+//   bias : fp32[N]; loaded as the accumulator with ldm = 0, which broadcasts
+//          the single bias row to every M row of the tile.
+//   stage: fp32 [TILE_M x N] local-memory scratch for the accumulator tile
+//   out  : fp16 row-major in local memory (or nullptr to keep fp32 in stage)
+template <uint32_t K, uint32_t N, bool RELU>
+static inline void layer_tcu(const uint16_t* in, const uint16_t* wt, const float* bias,
+                             float* stage, uint16_t* out) {
+  // TODO(student): for every tileN-wide column block j of the output:
+  //   1. initialize the accumulator fragment with the bias (see the comment above for
+  //      the ldm that broadcasts one row to all M rows),
+  //   2. accumulate in[:, k:k+tileK] x W[k:k+tileK, j:j+tileN] over all k with
+  //      ctx::load_matrix_sync / ctx::mma_sync (wt is B^T, i.e. col_major B),
+  //   3. store the fp32 tile to stage with ctx::store_matrix_sync.
+  // Then, if out != nullptr, apply ReLU (when RELU) to stage and pack it to 16-bit
+  // with nt_pack(), spreading the TILE_M x N elements over the warp's lanes.
+  // Mind the local-memory ordering between the two phases (vx_fence()).
+  (void)in; (void)wt; (void)bias; (void)stage; (void)out;
+}
+
+__kernel void kernel_main(kernel_arg_t* __UNIFORM__ arg) {
+  const uint32_t W = arg->width, H = arg->height;
+  const uint32_t lane = vx_thread_id();
+  const uint32_t pix0 = blockIdx.x * TILE_M;
+
+  // Per-block local-memory staging: 16-bit activations X (features), H (layer 0 out),
+  // H2 (layer 1 out), and one fp32 accumulator tile shared by all layers.
+  // TODO(student): carve these four buffers out of __local_mem(). The total must match
+  // the lmem_size the host requests in main.cpp.
+  uint16_t* bufX  = nullptr;
+  uint16_t* bufH  = nullptr;
+  uint16_t* bufH2 = nullptr;
+  float*    stage = nullptr;
+
+  for (uint32_t r = lane; r < TILE_M; r += VX_CFG_NUM_THREADS) {
+    uint32_t p = pix0 + r;
+    float u = ((float)(p % W) + 0.5f) / (float)W;
+    float v = ((float)(p / W) + 0.5f) / (float)H;
+    float f[NFEAT];
+    nt_make_features(u, v, f);
+    for (uint32_t k = 0; k < NFEAT; ++k)
+      bufX[r * NFEAT + k] = nt_pack(f[k]);
+  }
+  vx_fence();
+
+  layer_tcu<NT_L0_K, NT_L0_N, true >(bufX,  (const uint16_t*)(uintptr_t)arg->w0_addr, (const float*)(uintptr_t)arg->b0_addr, stage, bufH);
+  layer_tcu<NT_L1_K, NT_L1_N, true >(bufH,  (const uint16_t*)(uintptr_t)arg->w1_addr, (const float*)(uintptr_t)arg->b1_addr, stage, bufH2);
+  layer_tcu<NT_L2_K, NT_L2_N, false>(bufH2, (const uint16_t*)(uintptr_t)arg->w2_addr, (const float*)(uintptr_t)arg->b2_addr, stage, nullptr);
+
+  auto dst = reinterpret_cast<uint32_t*>((uintptr_t)arg->dst_addr);
+  for (uint32_t r = lane; r < TILE_M; r += VX_CFG_NUM_THREADS) {
+    uint32_t p = pix0 + r;
+    if (p < W * H) {
+      const float* y = stage + r * NT_L2_N;
+      dst[p] = pack_rgba8(y[0], y[1], y[2]);
+    }
+  }
+}
+
+#else  // NEURAL_TEX_SCALAR
+
+// Plain-FMA baseline: every lane evaluates its own pixel in registers with the
+// same fp16-quantized weights (stored as fp32 [K][N]).
+template <uint32_t K, uint32_t N, uint32_t LD, bool RELU>
+static inline void layer_scalar(const float* in, const float* w, const float* bias, float* out) {
+  for (uint32_t n = 0; n < N; ++n) {
+    float acc = bias[n];
+    for (uint32_t k = 0; k < K; ++k)
+      acc += in[k] * w[k * LD + n];
+    out[n] = (RELU && acc < 0.0f) ? 0.0f : acc;
+  }
+}
+
+__kernel void kernel_main(kernel_arg_t* __UNIFORM__ arg) {
+  const uint32_t W = arg->width, H = arg->height;
+  const uint32_t p = blockIdx.x * TILE_M + vx_thread_id();
+  if (p >= W * H) return;
+  float u = ((float)(p % W) + 0.5f) / (float)W;
+  float v = ((float)(p / W) + 0.5f) / (float)H;
+  float f[NFEAT], h1[NT_L0_N], h2[NT_L1_N], y[NT_L2_N];
+  nt_make_features(u, v, f);
+  layer_scalar<NT_L0_K, NT_L0_N, NT_L0_N, true >(f,  (const float*)(uintptr_t)arg->w0_addr, (const float*)(uintptr_t)arg->b0_addr, h1);
+  layer_scalar<NT_L1_K, NT_L1_N, NT_L1_N, true >(h1, (const float*)(uintptr_t)arg->w1_addr, (const float*)(uintptr_t)arg->b1_addr, h2);
+  layer_scalar<NT_L2_K, 3,       NT_L2_N, false>(h2, (const float*)(uintptr_t)arg->w2_addr, (const float*)(uintptr_t)arg->b2_addr, y);
+  auto dst = reinterpret_cast<uint32_t*>((uintptr_t)arg->dst_addr);
+  dst[p] = pack_rgba8(y[0], y[1], y[2]);
+}
+
+#endif
diff --git a/tests/regression/neural_tex/main.cpp b/tests/regression/neural_tex/main.cpp
new file mode 100644
index 0000000..5123f3c
--- /dev/null
+++ b/tests/regression/neural_tex/main.cpp
@@ -0,0 +1,249 @@
+// neural_tex host: uploads the fp16 MLP weights produced by train_mlp.py,
+// decodes a WxH image on the device, compares it against a CPU evaluation of
+// the same quantized network (bit-level tolerance) and against the original
+// texture (PSNR), and writes both images as PPM.
+#include "common.h"
+#include "neural_tex_math.h"
+#ifndef NEURAL_TEX_WEIGHTS_H
+#define NEURAL_TEX_WEIGHTS_H "neural_tex_weights.h"
+#endif
+#include NEURAL_TEX_WEIGHTS_H
+#include <tensor_cfg.h>
+#include <vortex2.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#define RT_CHECK(_expr)                                      \
+  do {                                                       \
+    int _ret = _expr;                                        \
+    if (0 == _ret)                                           \
+      break;                                                 \
+    printf("Error: '%s' returned %d!\n", #_expr, (int)_ret); \
+    cleanup();                                               \
+    exit(-1);                                                \
+  } while (false)
+
+namespace vt = vortex::tensor;
+
+#ifndef NEURAL_TEX_SCALAR
+using cfg = vt::wmma_config_t<VX_CFG_NUM_THREADS, vt::NT_ITYPE, vt::fp32>;
+static constexpr uint32_t TILE_M = cfg::tileM;
+#else
+static constexpr uint32_t TILE_M = VX_CFG_NUM_THREADS;
+#endif
+
+static const char* kernel_file = "kernel.vxbin";
+static uint32_t W = NT_TEX_W, H = NT_TEX_H;
+static std::string out_path = "neural_tex_out.ppm";
+static std::string ref_path = "neural_tex_ref.ppm";
+
+static vx_device_h device = nullptr;
+static vx_queue_h queue = nullptr;
+static vx_module_h module_ = nullptr;
+static vx_kernel_h kernel = nullptr;
+static vx_buffer_h bufs[7] = {};
+static kernel_arg_t kernel_arg = {};
+
+static void cleanup() {
+  for (auto b : bufs) if (b) vx_buffer_release(b);
+  if (kernel) vx_kernel_release(kernel);
+  if (module_) vx_module_release(module_);
+  if (queue) vx_queue_release(queue);
+  if (device) {
+    vx_device_dump_perf(device, stdout);
+    vx_device_release(device);
+  }
+}
+
+static void parse_args(int argc, char** argv) {
+  for (int i = 1; i < argc; ++i) {
+    std::string a = argv[i];
+    if (a == "-w" && i + 1 < argc) W = std::stoi(argv[++i]);
+    else if (a == "-h" && i + 1 < argc) H = std::stoi(argv[++i]);
+    else if (a == "-k" && i + 1 < argc) kernel_file = argv[++i];
+    else if (a == "-o" && i + 1 < argc) out_path = argv[++i];
+    else { std::cout << "usage: [-w width] [-h height] [-k kernel] [-o out.ppm]\n"; exit(a == "-?" ? 0 : -1); }
+  }
+}
+
+static void write_ppm(const std::string& path, const std::vector<uint8_t>& rgb, uint32_t w, uint32_t h) {
+  FILE* f = fopen(path.c_str(), "wb");
+  if (!f) { std::cout << "cannot write " << path << "\n"; return; }
+  fprintf(f, "P6\n%u %u\n255\n", w, h);
+  fwrite(rgb.data(), 1, rgb.size(), f);
+  fclose(f);
+}
+
+static inline float q16(float x) { return nt_unpack(nt_pack(x)); }
+
+template <uint32_t K, uint32_t N, bool RELU, bool FP16_ACT>
+static void layer_cpu(const float* in, const float* w, const float* b, float* out) {
+  for (uint32_t n = 0; n < N; ++n) {
+    float acc = b[n];
+    for (uint32_t k = 0; k < K; ++k) acc += (FP16_ACT ? q16(in[k]) : in[k]) * w[k * N + n];
+    if (RELU && acc < 0.0f) acc = 0.0f;
+    out[n] = acc;
+  }
+}
+
+static uint8_t q8(float x) {
+  x = std::min(1.0f, std::max(0.0f, x));
+  return (uint8_t)(x * 255.0f + 0.5f);
+}
+
+int main(int argc, char** argv) {
+  parse_args(argc, argv);
+
+  std::cout << "open device connection" << std::endl;
+  RT_CHECK(vx_device_open(0, &device));
+  vx_queue_info_t qi = { sizeof(qi), nullptr, VX_QUEUE_PRIORITY_NORMAL, 0 };
+  RT_CHECK(vx_queue_create(device, &qi, &queue));
+
+  uint64_t isa_flags = 0, NT = 0;
+  RT_CHECK(vx_device_query(device, VX_CAPS_ISA_FLAGS, &isa_flags));
+  RT_CHECK(vx_device_query(device, VX_CAPS_NUM_THREADS, &NT));
+  if (NT != VX_CFG_NUM_THREADS) {
+    std::cout << "Error: device warp size (" << NT << ") must match VX_CFG_NUM_THREADS=" << VX_CFG_NUM_THREADS << "!" << std::endl;
+    cleanup();
+    return -1;
+  }
+#ifndef NEURAL_TEX_SCALAR
+  if (!(isa_flags & VX_ISA_EXT_TCU)) {
+    std::cout << "TCU extension not supported!" << std::endl;
+    cleanup();
+    return -1;
+  }
+  std::cout << "path: TCU wmma (" << vt::NT_ITYPE::name << " x " << vt::NT_ITYPE::name << " -> fp32), tile M=" << cfg::tileM << " N=" << cfg::tileN << " K=" << cfg::tileK << std::endl;
+#else
+  std::cout << "path: scalar FMA (fp32)" << std::endl;
+#endif
+  std::cout << "MLP: " << NT_L0_K << " -> " << NT_HIDDEN << " -> " << NT_HIDDEN << " -> 3 (padded to " << NT_L2_N << "), image " << W << "x" << H << std::endl;
+
+  const uint32_t num_pixels = W * H;
+  const uint32_t num_blocks = (num_pixels + TILE_M - 1) / TILE_M;
+
+  // weights: TCU path uploads fp16 B^T [N][K]; scalar path uploads fp32 [K][N]
+#ifndef NEURAL_TEX_SCALAR
+#ifdef NEURAL_TEX_FP16
+  const void* wsrc[3] = { nt_w0_t_fp16, nt_w1_t_fp16, nt_w2_t_fp16 };
+  const size_t wbytes[3] = { sizeof(nt_w0_t_fp16), sizeof(nt_w1_t_fp16), sizeof(nt_w2_t_fp16) };
+#else
+  const void* wsrc[3] = { nt_w0_t_bf16, nt_w1_t_bf16, nt_w2_t_bf16 };
+  const size_t wbytes[3] = { sizeof(nt_w0_t_bf16), sizeof(nt_w1_t_bf16), sizeof(nt_w2_t_bf16) };
+#endif
+#else
+  const void* wsrc[3] = { nt_w0_fp32, nt_w1_fp32, nt_w2_fp32 };
+  const size_t wbytes[3] = { sizeof(nt_w0_fp32), sizeof(nt_w1_fp32), sizeof(nt_w2_fp32) };
+#endif
+  const void* bsrc[3] = { nt_b0_fp32, nt_b1_fp32, nt_b2_fp32 };
+  const size_t bbytes[3] = { sizeof(nt_b0_fp32), sizeof(nt_b1_fp32), sizeof(nt_b2_fp32) };
+  uint64_t* waddr[3] = { &kernel_arg.w0_addr, &kernel_arg.w1_addr, &kernel_arg.w2_addr };
+  uint64_t* baddr[3] = { &kernel_arg.b0_addr, &kernel_arg.b1_addr, &kernel_arg.b2_addr };
+
+  std::cout << "allocate device memory" << std::endl;
+  for (int i = 0; i < 3; ++i) {
+    RT_CHECK(vx_buffer_create(device, wbytes[i], VX_MEM_READ, &bufs[2 * i]));
+    RT_CHECK(vx_buffer_address(bufs[2 * i], waddr[i]));
+    RT_CHECK(vx_buffer_create(device, bbytes[i], VX_MEM_READ, &bufs[2 * i + 1]));
+    RT_CHECK(vx_buffer_address(bufs[2 * i + 1], baddr[i]));
+    RT_CHECK(vx_enqueue_write(queue, bufs[2 * i], 0, wsrc[i], wbytes[i], 0, nullptr, nullptr));
+    RT_CHECK(vx_enqueue_write(queue, bufs[2 * i + 1], 0, bsrc[i], bbytes[i], 0, nullptr, nullptr));
+  }
+  RT_CHECK(vx_buffer_create(device, num_blocks * TILE_M * sizeof(uint32_t), VX_MEM_WRITE, &bufs[6]));
+  RT_CHECK(vx_buffer_address(bufs[6], &kernel_arg.dst_addr));
+  kernel_arg.width = W;
+  kernel_arg.height = H;
+
+  std::cout << "load kernel module" << std::endl;
+  RT_CHECK(vx_module_load_file(device, kernel_file, &module_));
+  RT_CHECK(vx_module_get_kernel(module_, "main", &kernel));
+
+  vx_launch_info_t li = {};
+  li.struct_size  = sizeof(li);
+  li.kernel       = kernel;
+  li.args_host    = &kernel_arg;
+  li.args_size    = sizeof(kernel_arg);
+  li.ndim         = 1;
+  li.grid_dim[0]  = num_blocks;
+  li.block_dim[0] = (uint32_t)NT;
+#ifndef NEURAL_TEX_SCALAR
+  // TODO(student): local memory per block for the kernel's X/H/H2 16-bit activations
+  // and the fp32 accumulator tile (must match the carve-up in kernel.cpp).
+  li.lmem_size = 0;
+#endif
+
+  std::cout << "launch kernel: " << num_blocks << " blocks x " << NT << " threads, lmem/block=" << li.lmem_size << " B" << std::endl;
+  vx_event_h launch_ev = nullptr, read_ev = nullptr;
+  RT_CHECK(vx_enqueue_launch(queue, &li, 0, nullptr, &launch_ev));
+  std::vector<uint32_t> h_dst(num_blocks * TILE_M);
+  RT_CHECK(vx_enqueue_read(queue, h_dst.data(), bufs[6], 0, h_dst.size() * sizeof(uint32_t), 1, &launch_ev, &read_ev));
+  RT_CHECK(vx_event_wait_value(read_ev, 1, VX_TIMEOUT_INFINITE));
+  vx_event_release(read_ev);
+  vx_event_release(launch_ev);
+
+  // CPU evaluation of the same quantized network (fp16 activations on the TCU path)
+  std::cout << "verify against CPU reference" << std::endl;
+  std::vector<uint8_t> dev_rgb(num_pixels * 3), cpu_rgb(num_pixels * 3);
+  int errors = 0, max_diff = 0;
+  for (uint32_t p = 0; p < num_pixels; ++p) {
+    float u = ((float)(p % W) + 0.5f) / (float)W;
+    float v = ((float)(p / W) + 0.5f) / (float)H;
+    float f[NT_L0_K], h1[NT_L0_N], h2[NT_L1_N], y[NT_L2_N];
+    nt_make_features(u, v, f);
+#ifndef NEURAL_TEX_SCALAR
+    constexpr bool act16 = true;
+#else
+    constexpr bool act16 = false;
+#endif
+    layer_cpu<NT_L0_K, NT_L0_N, true,  act16>(f,  nt_w0_fp32, nt_b0_fp32, h1);
+    layer_cpu<NT_L1_K, NT_L1_N, true,  act16>(h1, nt_w1_fp32, nt_b1_fp32, h2);
+    layer_cpu<NT_L2_K, NT_L2_N, false, act16>(h2, nt_w2_fp32, nt_b2_fp32, y);
+    uint32_t d = h_dst[p];
+    uint8_t dc[3] = { (uint8_t)(d & 0xff), (uint8_t)((d >> 8) & 0xff), (uint8_t)((d >> 16) & 0xff) };
+    for (int c = 0; c < 3; ++c) {
+      uint8_t rc = q8(y[c]);
+      int diff = std::abs((int)dc[c] - (int)rc);
+      max_diff = std::max(max_diff, diff);
+      if (diff > 3) {
+        if (errors < 8)
+          printf("  mismatch pixel %u ch%d: device=%u cpu=%u\n", p, c, dc[c], rc);
+        ++errors;
+      }
+      dev_rgb[p * 3 + c] = dc[c];
+      cpu_rgb[p * 3 + c] = rc;
+    }
+  }
+  printf("device vs CPU: max |diff| = %d/255, %d channel mismatches (> 3)\n", max_diff, errors);
+
+  // PSNR against the original texture (only when rendered at its native size)
+  if (W == NT_TEX_W && H == NT_TEX_H) {
+    double mse = 0.0;
+    for (uint32_t i = 0; i < num_pixels * 3; ++i) {
+      double d = ((double)dev_rgb[i] - (double)nt_ref_rgb8[i]) / 255.0;
+      mse += d * d;
+    }
+    mse /= (double)(num_pixels * 3);
+    double psnr = 10.0 * log10(1.0 / std::max(mse, 1e-12));
+    printf("PSNR(device, reference texture) = %.2f dB\n", psnr);
+    if (psnr < 20.0) {
+      printf("PSNR below 20 dB threshold\n");
+      ++errors;
+    }
+    write_ppm(ref_path, std::vector<uint8_t>(nt_ref_rgb8, nt_ref_rgb8 + num_pixels * 3), W, H);
+  }
+  write_ppm(out_path, dev_rgb, W, H);
+  std::cout << "wrote " << out_path << std::endl;
+
+  cleanup();
+  if (errors != 0) {
+    std::cout << "FAILED! - " << errors << " errors" << std::endl;
+    return 1;
+  }
+  std::cout << "PASSED!" << std::endl;
+  return 0;
+}
diff --git a/tests/regression/neural_tex/neural_tex_fp16.h b/tests/regression/neural_tex/neural_tex_fp16.h
new file mode 100644
index 0000000..5c23121
--- /dev/null
+++ b/tests/regression/neural_tex/neural_tex_fp16.h
@@ -0,0 +1,53 @@
+#ifndef _NEURAL_TEX_FP16_H_
+#define _NEURAL_TEX_FP16_H_
+
+// Software IEEE binary16 <-> binary32 (round-to-nearest-even). rv32imaf has
+// no Zfh, so the kernel packs activations with this; the host uses the same
+// code so its reference matches the device bit-for-bit on the conversions.
+
+#include <stdint.h>
+#include <string.h>
+
+static inline uint32_t nt_f32_bits(float f) { uint32_t u; memcpy(&u, &f, 4); return u; }
+static inline float nt_bits_f32(uint32_t u) { float f; memcpy(&f, &u, 4); return f; }
+
+static inline uint16_t nt_f32_to_f16(float f) {
+  uint32_t x = nt_f32_bits(f);
+  uint32_t sign = (x >> 16) & 0x8000u;
+  int32_t  exp  = (int32_t)((x >> 23) & 0xffu) - 127 + 15;
+  uint32_t mant = x & 0x7fffffu;
+  if (((x >> 23) & 0xffu) == 0xffu) return (uint16_t)(sign | 0x7c00u | (mant ? 0x200u : 0));
+  if (exp >= 31) return (uint16_t)(sign | 0x7c00u);
+  if (exp <= 0) {
+    if (exp < -10) return (uint16_t)sign;
+    mant |= 0x800000u;
+    uint32_t shift = (uint32_t)(14 - exp);
+    uint32_t h = mant >> shift;
+    uint32_t rem = mant & ((1u << shift) - 1u);
+    uint32_t half = 1u << (shift - 1);
+    if (rem > half || (rem == half && (h & 1u))) h++;
+    return (uint16_t)(sign | h);
+  }
+  uint32_t h = sign | ((uint32_t)exp << 10) | (mant >> 13);
+  uint32_t rem = mant & 0x1fffu;
+  if (rem > 0x1000u || (rem == 0x1000u && (h & 1u))) h++;
+  return (uint16_t)h;
+}
+
+static inline float nt_f16_to_f32(uint16_t h) {
+  uint32_t sign = ((uint32_t)h & 0x8000u) << 16;
+  uint32_t exp  = (h >> 10) & 0x1fu;
+  uint32_t mant = h & 0x3ffu;
+  if (exp == 0) {
+    if (mant == 0) return nt_bits_f32(sign);
+    // subnormal: normalize
+    exp = 127 - 15 + 1;
+    while ((mant & 0x400u) == 0) { mant <<= 1; exp--; }
+    mant &= 0x3ffu;
+    return nt_bits_f32(sign | (exp << 23) | (mant << 13));
+  }
+  if (exp == 31) return nt_bits_f32(sign | 0x7f800000u | (mant << 13));
+  return nt_bits_f32(sign | ((exp + 127 - 15) << 23) | (mant << 13));
+}
+
+#endif
diff --git a/tests/regression/neural_tex/neural_tex_math.h b/tests/regression/neural_tex/neural_tex_math.h
new file mode 100644
index 0000000..e02e87d
--- /dev/null
+++ b/tests/regression/neural_tex/neural_tex_math.h
@@ -0,0 +1,73 @@
+#ifndef _NEURAL_TEX_MATH_H_
+#define _NEURAL_TEX_MATH_H_
+
+// Shared host/device feature math. libm's sinf/cosf cost ~1000 instructions
+// each on rv32imaf (soft-double inside), which would dwarf the MLP itself, so
+// the Fourier features use a 9th-order odd polynomial in "turns" (|err| < 4e-6)
+// and derive the higher octaves by angle doubling. Host and kernel share this
+// code so the CPU reference tracks the device bit-for-bit.
+
+#include <stdint.h>
+#include "neural_tex_fp16.h"
+
+#define NT_NFEAT 16
+
+// sin(2*pi*t) for t in [-0.5, 0.5]
+static inline float nt_sin_turn(float t) {
+  if (t > 0.25f) t = 0.5f - t;
+  else if (t < -0.25f) t = -0.5f - t;
+  float t2 = t * t;
+  const float a1 = 6.28318530718f, a3 = -41.3417022404f, a5 = 81.6052492761f,
