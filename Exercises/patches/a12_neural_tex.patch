+#!/usr/bin/env python3
+# Train a tiny coordinate MLP (Fourier features of (u,v) -> RGB) that
+# reproduces one texture, quantize its weights to fp16 and emit a C header
+# (neural_tex_weights.h, fp16 and bf16 variants) consumed by the Vortex
+# kernel/host of this test.
+#
+#   python3 train_mlp.py --image assets/monalisa.png --size 64 --hidden 16
+#   python3 train_mlp.py --procedural
+#   python3 train_mlp.py --compare ref.ppm out.ppm side_by_side.png
+#
+# numpy only (no torch). Training is full-batch Adam on 64x64 = 4096 samples;
+# ~20 s of CPU for 4000 iterations with hidden=16 (set OMP_NUM_THREADS=1 on a
+# shared machine: numpy thread thrash makes it 10x slower).
+import argparse, sys, time
+import numpy as np
+
+NFEAT = 16          # input features (K of layer 1), multiple of every TCU tileK <= 16
+OUT_PAD = 16        # RGB output padded to a multiple of the TCU tileN
+NFREQ = 3           # Fourier octaves: 2^0..2^(NFREQ-1) * pi
+
+def load_texture(args):
+    if args.procedural:
+        n = args.size
+        y, x = np.mgrid[0:n, 0:n] / n
+        r = 0.5 + 0.5 * np.sin(2 * np.pi * 3 * x)
+        g = ((x * 8).astype(int) + (y * 8).astype(int)) % 2
+        b = np.exp(-((x - 0.5) ** 2 + (y - 0.5) ** 2) * 20)
+        return np.stack([r, g, b], -1).astype(np.float32)
+    from PIL import Image
+    im = Image.open(args.image).convert("RGB")
+    if args.crop:
+        im = im.crop((0, 0, args.crop, args.crop))
+    im = im.resize((args.size, args.size), Image.LANCZOS)
+    return np.asarray(im).astype(np.float32) / 255.0
+
+def features(uv):
+    # uv: (N,2) in [0,1). Matches neural_tex kernel.cpp::make_features exactly
+    # (the kernel derives the higher octaves by angle doubling, which is the
+    # same function up to fp32 rounding).
+    u, v = uv[:, 0], uv[:, 1]
+    f = [2 * u - 1, 2 * v - 1]
+    for k in range(NFREQ):
+        w = (2.0 ** k) * 2 * np.pi
+        f += [np.sin(w * u), np.cos(w * u), np.sin(w * v), np.cos(w * v)]
+    f += [np.sin((2.0 ** NFREQ) * 2 * np.pi * u), np.sin((2.0 ** NFREQ) * 2 * np.pi * v)]
+    f = np.stack(f, -1).astype(np.float32)
+    assert f.shape[1] == NFEAT
+    return f
+
+def init_layer(rng, k, n):
+    return (rng.standard_normal((k, n)) * np.sqrt(2.0 / k)).astype(np.float32), np.zeros(n, np.float32)
+
+def to_bf16_bits(a):
+    b = np.ascontiguousarray(a, dtype=np.float32).view(np.uint32)
+    b = b + 0x7FFF + ((b >> 16) & 1)            # round to nearest even
+    return (b >> 16).astype(np.uint16)
+
+def from_bf16_bits(h):
+    return (h.astype(np.uint32) << 16).view(np.float32)
+
+def quant(a, mode):
+    if mode == "fp16":
+        return a.astype(np.float16).astype(np.float32)
+    if mode == "bf16":
+        return from_bf16_bits(to_bf16_bits(a))
+    return a
+
+def forward(params, x, qmode=None):
+    acts = [x]
+    h = x
+    for i, (w, b) in enumerate(params):
+        if qmode:
+            h = quant(h, qmode)
+            w = quant(w, qmode)
+        h = h @ w + b
+        if i < len(params) - 1:
+            h = np.maximum(h, 0)
+        acts.append(h)
+    return acts
+
+def train(params, x, y, iters, lr):
+    m = [(np.zeros_like(w), np.zeros_like(b)) for w, b in params]
+    v = [(np.zeros_like(w), np.zeros_like(b)) for w, b in params]
+    b1, b2, eps = 0.9, 0.999, 1e-8
+    t0 = time.time()
+    for it in range(1, iters + 1):
+        acts = forward(params, x)
+        out = acts[-1]
+        diff = out - y
+        loss = float(np.mean(diff ** 2))
+        g = (2.0 / diff.size) * diff
+        grads = []
+        for i in range(len(params) - 1, -1, -1):
+            w, b = params[i]
+            a_in = acts[i]
+            gw = a_in.T @ g
+            gb = g.sum(0)
+            grads.append((gw, gb))
+            if i > 0:
+                g = (g @ w.T) * (acts[i] > 0)
+        grads.reverse()
+        lr_t = lr * (0.5 * (1 + np.cos(np.pi * it / iters)))  # cosine decay
+        for i, ((w, b), (gw, gb)) in enumerate(zip(params, grads)):
+            for p, gp, mp, vp in ((w, gw, m[i][0], v[i][0]), (b, gb, m[i][1], v[i][1])):
+                mp *= b1; mp += (1 - b1) * gp
+                vp *= b2; vp += (1 - b2) * gp * gp
+                mh = mp / (1 - b1 ** it)
+                vh = vp / (1 - b2 ** it)
+                p -= (lr_t * mh / (np.sqrt(vh) + eps)).astype(np.float32)
+        if it % 500 == 0 or it == 1:
+            print(f"iter {it:5d}  mse {loss:.5f}  psnr {psnr(loss):.2f} dB  ({time.time() - t0:.1f}s)")
+    return params
+
+def psnr(mse):
+    return 10 * np.log10(1.0 / max(mse, 1e-12))
+
+def c_array(name, ctype, vals, per_line=16):
+    lines = [f"static const {ctype} {name}[{len(vals)}] = {{"]
+    for i in range(0, len(vals), per_line):
+        lines.append("  " + ", ".join(vals[i:i + per_line]) + ",")
+    lines.append("};")
+    return "\n".join(lines)
+
+def emit_header(path, params, tex, hidden, uv_order):
+    # Layer i: W (K x N) fp32; TCU wants B^T row-major (N rows of K halves)
+    # because load_matrix_sync<col_major>(fragB, Wt + n*K + k, K) is how
+    # sgemm_tcu feeds B. Output layer padded from 3 to OUT_PAD columns.
+    dims = []
+    chunks = ["// Generated by train_mlp.py -- do not edit.",
+              "#pragma once", "#include <stdint.h>", ""]
+    for i, (w, b) in enumerate(params):
+        k, n = w.shape
+        if i == len(params) - 1:
+            wp = np.zeros((k, OUT_PAD), np.float32); wp[:, :n] = w
+            bp = np.zeros(OUT_PAD, np.float32); bp[:n] = b
+            w, b, n = wp, bp, OUT_PAD
+        dims.append((k, n))
+        w16 = w.astype(np.float16)
+        wt16 = np.ascontiguousarray(w16.T)                     # [n][k]
+        wb16_bits = to_bf16_bits(w)
+        wtb16_bits = np.ascontiguousarray(wb16_bits.T)
+        chunks.append(f"#define NT_L{i}_K {k}")
+        chunks.append(f"#define NT_L{i}_N {n}")
+        chunks.append(c_array(f"nt_w{i}_t_fp16", "uint16_t",
+                              [f"0x{x:04x}" for x in wt16.view(np.uint16).ravel()]))
+        chunks.append(c_array(f"nt_w{i}_t_bf16", "uint16_t",
+                              [f"0x{x:04x}" for x in wtb16_bits.ravel()]))
+        chunks.append(c_array(f"nt_w{i}_fp32_fp16", "float",
+                              [f"{x:.8e}f" for x in w16.astype(np.float32).ravel()]))   # [k][n]
+        chunks.append(c_array(f"nt_w{i}_fp32_bf16", "float",
+                              [f"{x:.8e}f" for x in from_bf16_bits(wb16_bits).ravel()]))
+        chunks.append(c_array(f"nt_b{i}_fp32", "float", [f"{x:.8e}f" for x in b]))
+        chunks.append("")
+    h, wd, _ = tex.shape
+    chunks.append(f"#define NT_TEX_W {wd}")
+    chunks.append(f"#define NT_TEX_H {h}")
+    chunks.append(f"#define NT_HIDDEN {hidden}")
+    chunks.append(f"#define NT_NUM_LAYERS {len(params)}")
+    rgb = np.clip(np.round(tex * 255), 0, 255).astype(np.uint8)
+    chunks.append(c_array("nt_ref_rgb8", "uint8_t", [str(int(x)) for x in rgb.ravel()], 32))
+    open(path, "w").write("\n".join(chunks) + "\n")
+    print("wrote", path, "layers", dims)
+
+def write_ppm(path, img):
+    h, w, _ = img.shape
+    with open(path, "wb") as f:
+        f.write(f"P6\n{w} {h}\n255\n".encode())
+        f.write(np.clip(np.round(img * 255), 0, 255).astype(np.uint8).tobytes())
+
+def read_ppm(path):
+    from PIL import Image
+    return np.asarray(Image.open(path).convert("RGB")).astype(np.float32) / 255.0
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--image", default="assets/monalisa.png")
+    ap.add_argument("--procedural", action="store_true")
+    ap.add_argument("--crop", type=int, default=0, help="crop top-left square before resize")
+    ap.add_argument("--size", type=int, default=64)
+    ap.add_argument("--hidden", type=int, default=16)
+    ap.add_argument("--iters", type=int, default=4000)
+    ap.add_argument("--lr", type=float, default=3e-3)
+    ap.add_argument("--seed", type=int, default=1)
+    ap.add_argument("--out", default="neural_tex_weights.h")
+    ap.add_argument("--compare", nargs=3, metavar=("REF_PPM", "OUT_PPM", "PNG"))
+    args = ap.parse_args()
+
+    if args.compare:
+        from PIL import Image
+        a, b = read_ppm(args.compare[0]), read_ppm(args.compare[1])
+        mse = float(np.mean((a - b) ** 2))
+        print(f"PSNR(ref, out) = {psnr(mse):.2f} dB")
+        s = 4
+        canvas = np.concatenate([a, np.ones((a.shape[0], 4, 3)), b], 1)
+        Image.fromarray((canvas * 255).astype(np.uint8)).resize(
+            (canvas.shape[1] * s, canvas.shape[0] * s), Image.NEAREST).save(args.compare[2])
+        print("wrote", args.compare[2])
+        return
+
+    assert args.hidden % 16 == 0, "hidden must be a multiple of 16 (TCU tile padding)"
+    tex = load_texture(args)
+    n = args.size
+    v, u = np.mgrid[0:n, 0:n]
+    uv = np.stack([(u + 0.5) / n, (v + 0.5) / n], -1).reshape(-1, 2).astype(np.float32)
+    x = features(uv)
+    y = tex.reshape(-1, 3)
+
+    rng = np.random.default_rng(args.seed)
+    params = [init_layer(rng, NFEAT, args.hidden),
+              init_layer(rng, args.hidden, args.hidden),
+              init_layer(rng, args.hidden, 3)]
+    params = train(params, x, y, args.iters, args.lr)
+
+    out32 = forward(params, x)[-1]
+    out16 = forward(params, x, "fp16")[-1]
+    outb16 = forward(params, x, "bf16")[-1]
+    print(f"fp32 model PSNR {psnr(float(np.mean((out32 - y) ** 2))):.2f} dB, "
+          f"fp16-quantized {psnr(float(np.mean((out16 - y) ** 2))):.2f} dB, "
+          f"bf16-quantized {psnr(float(np.mean((outb16 - y) ** 2))):.2f} dB")
+    nparams = sum(w.size + b.size for w, b in params)
+    print(f"params {nparams} -> {nparams * 2} bytes fp16 vs texture {n * n * 3} bytes RGB8 "
+          f"(ratio {n * n * 3 / (nparams * 2):.1f}x)")
+    emit_header(args.out, params, tex, args.hidden, "row-major")
+    write_ppm("ref.ppm", tex)
+    write_ppm("host_fp16.ppm", np.clip(out16, 0, 1).reshape(n, n, 3))
+    write_ppm("host_bf16.ppm", np.clip(outb16, 0, 1).reshape(n, n, 3))
+
+if __name__ == "__main__":
+    main()
