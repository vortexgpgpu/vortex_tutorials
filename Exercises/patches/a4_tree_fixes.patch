diff --git a/hw/unittest/tcu_fedp/fedp.h b/hw/unittest/tcu_fedp/fedp.h
--- a/hw/unittest/tcu_fedp/fedp.h
+++ b/hw/unittest/tcu_fedp/fedp.h
@@ -274,8 +274,10 @@ private:
 
   std::vector<std::array<dec_t, 2>> decode_inputs(const uint32_t *a, const uint32_t *b, uint32_t n) {
     const uint32_t width = 1u + exp_bits_ + sig_bits_;
-    const bool packed = (width <= 16u) && ((32u % width) == 0u);
-    const uint32_t epw = packed ? (32u / width) : 1u;
+    // Elements live in byte-multiple containers (a 6-bit format occupies the low 6 bits of a byte).
+    const uint32_t cwidth = (width <= 8u) ? 8u : (width <= 16u) ? 16u : 32u;
+    const bool packed = (cwidth <= 16u);
+    const uint32_t epw = packed ? (32u / cwidth) : 1u;
     std::vector<std::array<dec_t, 2>> out(n * epw);
     for (uint32_t w = 0; w < n; ++w) {
       uint32_t aw = a[w], bw = b[w];
@@ -283,7 +285,7 @@ private:
         uint32_t aenc = packed ? (aw & ((1u << width) - 1u)) : aw;
         uint32_t benc = packed ? (bw & ((1u << width) - 1u)) : bw;
