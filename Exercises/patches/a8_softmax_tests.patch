diff --git a/tests/hip/softmax/common.h b/tests/hip/softmax/common.h
new file mode 100644
index 0000000..c02e62c
--- /dev/null
+++ b/tests/hip/softmax/common.h
@@ -0,0 +1,40 @@
+#ifndef COMMON_H
+#define COMMON_H
+
+#include <hip/hip_runtime.h>
+
+// Relative tolerance of the host check: exp() is not correctly rounded on the
+// device and the row sum accumulates rounding error over cols terms.
+#define REL_TOL 1e-4
+// Outputs this small are compared with an absolute tolerance of REL_TOL * ABS_FLOOR.
+#define ABS_FLOOR 1e-12
+
+// expf() for the Vortex device, built from arithmetic and bit operations only.
+//
+// chipStar lowers HIP math functions (expf, fmaxf, sqrtf, ...) to OpenCL
+// builtin calls in SPIR-V (_Z3expf, _Z4fmaxff, ...), and the PoCL-Vortex kernel
+// library in this release does not export those names, so a kernel that calls
+// one fails to link at JIT time ("Cannot find symbol _Z3expf in kernel
+// library"). This is the Cephes expf: round-to-nearest range reduction
+// x = n*ln2 + r, a degree-6 polynomial for exp(r), then a 2^n exponent scale.
+__device__ inline float softmax_expf(float x) {
+  if (x < -87.33654f)
+    return 0.0f;
+  if (x > 88.0f)
+    x = 88.0f;
+  float t = x * 1.44269504088896341f;
+  int n = (int)(t >= 0.0f ? t + 0.5f : t - 0.5f);
+  float fn = (float)n;
+  float r = x - fn * 0.693359375f;
+  r = r - fn * -2.12194440e-4f;
+  float p = 1.9875691500e-4f;
+  p = p * r + 1.3981999507e-3f;
+  p = p * r + 8.3334519073e-3f;
+  p = p * r + 4.1665795894e-2f;
+  p = p * r + 1.6666665459e-1f;
+  p = p * r + 5.0000001201e-1f;
+  float y = p * r * r + r + 1.0f;
+  return y * __builtin_bit_cast(float, (n + 127) << 23);
+}
+
+#endif // COMMON_H
diff --git a/tests/hip/softmax/kernel.h b/tests/hip/softmax/kernel.h
