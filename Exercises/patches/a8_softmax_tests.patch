+#version 450
+
+// Row-wise softmax over a rows x cols row-major matrix.
+//   y[r][c] = exp(x[r][c] - max_r) / sum_c exp(x[r][c] - max_r)
+//
+// Launch: one invocation per row (the dispatch is rows rounded up to the
+// work-group size, so some invocations have no row to process).
+// Use the storage buffers only.
+
+layout(local_size_x_id = 0) in;
+
+layout(std430, binding = 0) readonly buffer In {
+   float x[];
+};
+
+layout(std430, binding = 1) buffer Out {
+   float y[];
+};
+
+layout(std140, binding = 2) uniform Params {
+   uint rows;
+   uint cols;
+};
+
+void main()
+{
+   // TODO: compute the row index of this invocation and skip out-of-range rows.
+   // TODO: pass 1 - find the row maximum.
+   // TODO: pass 2 - write exp(x - max) to y and accumulate the row sum.
+   // TODO: pass 3 - divide each output element by the row sum.
+}
