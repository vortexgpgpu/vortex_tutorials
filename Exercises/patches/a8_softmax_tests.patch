+++ b/tests/opencl/softmax/main.cc
@@ -0,0 +1,209 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <math.h>
+#include <CL/opencl.h>
+#include <unistd.h>
+#include <string.h>
+#include <chrono>
+#include <vector>
+
+#define KERNEL_NAME "softmax"
+
+// exp() is not correctly rounded on the device and the row sum accumulates
+// rounding error over cols terms, so compare with a relative tolerance.
+#define REL_TOL 1e-4
+// Outputs this small are compared with an absolute tolerance of REL_TOL * ABS_FLOOR.
+#define ABS_FLOOR 1e-12
+
+#define CL_CHECK(_expr)                                                \
+   do {                                                                \
+     cl_int _err = _expr;                                              \
+     if (_err == CL_SUCCESS)                                           \
+       break;                                                          \
+     printf("OpenCL Error: '%s' returned %d!\n", #_expr, (int)_err);   \
+     cleanup();                                                        \
+     exit(-1);                                                         \
+   } while (0)
+
+#define CL_CHECK2(_expr)                                               \
+   ({                                                                  \
+     cl_int _err = CL_INVALID_VALUE;                                   \
+     decltype(_expr) _ret = _expr;                                     \
+     if (_err != CL_SUCCESS) {                                         \
+       printf("OpenCL Error: '%s' returned %d!\n", #_expr, (int)_err); \
+       cleanup();                                                      \
+       exit(-1);                                                       \
+     }                                                                 \
+     _ret;                                                             \
+   })
+
+static int read_kernel_file(const char* filename, uint8_t** data, size_t* size) {
+  FILE* fp = fopen(filename, "r");
+  if (NULL == fp) {
+    fprintf(stderr, "Failed to load kernel.\n");
+    return -1;
+  }
+  fseek(fp, 0, SEEK_END);
+  long fsize = ftell(fp);
+  rewind(fp);
+  *data = (uint8_t*)malloc(fsize);
+  *size = fread(*data, 1, fsize, fp);
+  fclose(fp);
+  return 0;
+}
+
+static void softmax_cpu(float* out, const float* in, uint32_t rows, uint32_t cols) {
+  for (uint32_t r = 0; r < rows; ++r) {
+    const float* x = in + r * cols;
+    double m = x[0];
+    for (uint32_t c = 1; c < cols; ++c)
+      m = fmax(m, (double)x[c]);
+    double sum = 0.0;
+    for (uint32_t c = 0; c < cols; ++c)
+      sum += exp((double)x[c] - m);
+    for (uint32_t c = 0; c < cols; ++c)
+      out[r * cols + c] = (float)(exp((double)x[c] - m) / sum);
+  }
+}
+
+cl_device_id device_id = NULL;
+cl_context context = NULL;
+cl_command_queue commandQueue = NULL;
+cl_program program = NULL;
+cl_kernel kernel = NULL;
+cl_mem in_memobj = NULL;
+cl_mem out_memobj = NULL;
+uint8_t* kernel_bin = NULL;
+
+static void cleanup() {
+  if (commandQueue) clReleaseCommandQueue(commandQueue);
+  if (kernel) clReleaseKernel(kernel);
+  if (program) clReleaseProgram(program);
+  if (in_memobj) clReleaseMemObject(in_memobj);
+  if (out_memobj) clReleaseMemObject(out_memobj);
+  if (context) clReleaseContext(context);
+  if (device_id) clReleaseDevice(device_id);
+  if (kernel_bin) free(kernel_bin);
+}
+
+static uint32_t size = 64;
+static float scale = 1.0f;
+
+static void show_usage() {
+  printf("Usage: [-n size (matrix is size x size)] [-s input scale] [-h: help]\n");
+}
+
+static void parse_args(int argc, char** argv) {
+  int c;
+  while ((c = getopt(argc, argv, "n:s:h")) != -1) {
+    switch (c) {
+    case 'n': size = atoi(optarg); break;
+    case 's': scale = atof(optarg); break;
+    case 'h': show_usage(); exit(0);
+    default:  show_usage(); exit(-1);
+    }
+  }
+  printf("Workload size=%ux%u, input range=[0, %g)\n", size, size, scale);
+}
+
+int main(int argc, char** argv) {
+  parse_args(argc, argv);
+
+  uint32_t rows = size;
+  uint32_t cols = size;
+  size_t nbytes = (size_t)rows * cols * sizeof(float);
+
+  std::vector<float> h_in(rows * cols);
+  std::vector<float> h_out(rows * cols);
+  std::vector<float> h_ref(rows * cols);
+  srand(50);
+  for (auto& v : h_in)
+    v = scale * (static_cast<float>(rand()) / static_cast<float>(RAND_MAX));
+
+  cl_platform_id platform_id;
+  CL_CHECK(clGetPlatformIDs(1, &platform_id, NULL));
+  CL_CHECK(clGetDeviceIDs(platform_id, CL_DEVICE_TYPE_DEFAULT, 1, &device_id, NULL));
+
+  printf("Create context\n");
+  context = CL_CHECK2(clCreateContext(NULL, 1, &device_id, NULL, NULL, &_err));
+
+  printf("Allocate device buffers\n");
+  in_memobj = CL_CHECK2(clCreateBuffer(context, CL_MEM_READ_ONLY, nbytes, NULL, &_err));
+  out_memobj = CL_CHECK2(clCreateBuffer(context, CL_MEM_READ_WRITE, nbytes, NULL, &_err));
+
+  printf("Create program from kernel source\n");
+  size_t kernel_size;
+  if (0 != read_kernel_file("kernel.cl", &kernel_bin, &kernel_size))
+    return -1;
+  program = CL_CHECK2(clCreateProgramWithSource(
+    context, 1, (const char**)&kernel_bin, &kernel_size, &_err));
+
+  auto tb0 = std::chrono::high_resolution_clock::now();
+  cl_int build_err = clBuildProgram(program, 1, &device_id, NULL, NULL, NULL);
+  if (build_err != CL_SUCCESS) {
+    size_t log_size = 0;
+    clGetProgramBuildInfo(program, device_id, CL_PROGRAM_BUILD_LOG, 0, NULL, &log_size);
+    std::vector<char> log(log_size + 1, 0);
+    clGetProgramBuildInfo(program, device_id, CL_PROGRAM_BUILD_LOG, log_size, log.data(), NULL);
+    printf("Build log:\n%s\n", log.data());
+    CL_CHECK(build_err);
+  }
+  auto tb1 = std::chrono::high_resolution_clock::now();
+  printf("Program build time: %lld ms\n",
+         (long long)std::chrono::duration_cast<std::chrono::milliseconds>(tb1 - tb0).count());
+
+  kernel = CL_CHECK2(clCreateKernel(program, KERNEL_NAME, &_err));
+  CL_CHECK(clSetKernelArg(kernel, 0, sizeof(cl_mem), &in_memobj));
+  CL_CHECK(clSetKernelArg(kernel, 1, sizeof(cl_mem), &out_memobj));
+  CL_CHECK(clSetKernelArg(kernel, 2, sizeof(cl_uint), &rows));
+  CL_CHECK(clSetKernelArg(kernel, 3, sizeof(cl_uint), &cols));
+
+  commandQueue = CL_CHECK2(clCreateCommandQueue(context, device_id, 0, &_err));
+
+  printf("Upload source buffer\n");
+  CL_CHECK(clEnqueueWriteBuffer(commandQueue, in_memobj, CL_TRUE, 0, nbytes, h_in.data(), 0, NULL, NULL));
+
+  // One work-item per row; the work-group is as large as the device allows.
+  size_t max_wg = 0;
+  CL_CHECK(clGetKernelWorkGroupInfo(kernel, device_id, CL_KERNEL_WORK_GROUP_SIZE,
+                                    sizeof(max_wg), &max_wg, NULL));
+  size_t local_size = (max_wg < rows) ? max_wg : rows;
+  size_t global_size = ((rows + local_size - 1) / local_size) * local_size;
+  printf("Execute the kernel: global=%zu, local=%zu (device max=%zu)\n",
+         global_size, local_size, max_wg);
+
+  auto t0 = std::chrono::high_resolution_clock::now();
+  CL_CHECK(clEnqueueNDRangeKernel(commandQueue, kernel, 1, NULL, &global_size, &local_size, 0, NULL, NULL));
+  CL_CHECK(clFinish(commandQueue));
+  auto t1 = std::chrono::high_resolution_clock::now();
+  printf("Elapsed time: %lld ms\n",
+         (long long)std::chrono::duration_cast<std::chrono::milliseconds>(t1 - t0).count());
+
+  printf("Download destination buffer\n");
+  CL_CHECK(clEnqueueReadBuffer(commandQueue, out_memobj, CL_TRUE, 0, nbytes, h_out.data(), 0, NULL, NULL));
+
+  printf("Verify result\n");
+  softmax_cpu(h_ref.data(), h_in.data(), rows, cols);
+  int errors = 0;
+  double max_rel = 0.0;
+  for (uint32_t i = 0; i < rows * cols; ++i) {
+    double rel = fabs((double)h_out[i] - h_ref[i]) / fmax((double)h_ref[i], ABS_FLOOR);
+    if (!(rel <= REL_TOL)) {
+      if (errors < 100)
+        printf("*** error: [%u][%u] expected=%g, actual=%g\n", i / cols, i % cols, h_ref[i], h_out[i]);
+      ++errors;
+    }
+    if (rel > max_rel)
+      max_rel = rel;
+  }
+  printf("Max relative error: %.3g\n", max_rel);
+
+  cleanup();
+
+  if (0 == errors) {
+    printf("PASSED!\n");
+  } else {
+    printf("FAILED! - %d errors\n", errors);
+  }
+  return errors ? 1 : 0;
+}
