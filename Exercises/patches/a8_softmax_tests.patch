+#pragma once
+
+// Row-wise softmax over a rows x cols row-major matrix.
+//   out[r][c] = exp(in[r][c] - max_r) / sum_c exp(in[r][c] - max_r)
+//
+// Launch: 1-D grid, one thread per row (the grid is rows rounded up to the
+// block size, so some threads have no row to process).
+// Use global memory only: __shared__ + __syncthreads() does not build for the
+// 32-bit Vortex device in this release.
+// Use softmax_expf() from common.h instead of expf(), and a comparison instead
+// of fmaxf(): HIP math functions do not link on Vortex in this release.
+__global__ void softmax(const float* in, float* out, unsigned rows, unsigned cols) {
+  // TODO: compute the row index of this thread and skip out-of-range rows.
+  // TODO: pass 1 - find the row maximum.
+  // TODO: pass 2 - write exp(x - max) to out and accumulate the row sum.
+  // TODO: pass 3 - divide each output element by the row sum.
+}
diff --git a/tests/hip/softmax/main.cpp b/tests/hip/softmax/main.cpp
new file mode 100644
index 0000000..8036ebf
--- /dev/null
+++ b/tests/hip/softmax/main.cpp
@@ -0,0 +1,128 @@
+#include <hip/hip_runtime.h>
+
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <unistd.h>
+#include <vector>
+
+#include "common.h"
+// Copied into the build directory from KERNEL (see Makefile).
+#include <kernel.h>
+
+#define HIP_CHECK(_expr)                                                  \
+  do {                                                                    \
+    hipError_t _err = (_expr);                                            \
+    if (_err != hipSuccess) {                                             \
+      fprintf(stderr, "HIP Error: '%s' returned %d (%s)\n",               \
+              #_expr, (int)_err, hipGetErrorString(_err));                \
+      exit(-1);                                                           \
+    }                                                                     \
+  } while (0)
+
+static void softmax_cpu(float* out, const float* in, uint32_t rows, uint32_t cols) {
+  for (uint32_t r = 0; r < rows; ++r) {
+    const float* x = in + r * cols;
+    double m = x[0];
+    for (uint32_t c = 1; c < cols; ++c)
+      m = std::fmax(m, (double)x[c]);
+    double sum = 0.0;
+    for (uint32_t c = 0; c < cols; ++c)
+      sum += std::exp((double)x[c] - m);
+    for (uint32_t c = 0; c < cols; ++c)
+      out[r * cols + c] = (float)(std::exp((double)x[c] - m) / sum);
+  }
+}
+
+static uint32_t size = 64;
+static float scale = 1.0f;
+
+static void show_usage() {
+  printf("Usage: [-n size (matrix is size x size)] [-s input scale] [-h: help]\n");
+}
+
+static void parse_args(int argc, char** argv) {
+  int c;
+  while ((c = getopt(argc, argv, "n:s:h")) != -1) {
+    switch (c) {
+    case 'n': size = atoi(optarg); break;
+    case 's': scale = atof(optarg); break;
+    case 'h': show_usage(); exit(0);
+    default:  show_usage(); exit(-1);
+    }
+  }
+  printf("Workload size=%ux%u, input range=[0, %g)\n", size, size, scale);
+}
+
+int main(int argc, char** argv) {
+  parse_args(argc, argv);
+
+  uint32_t rows = size;
+  uint32_t cols = size;
+  size_t nbytes = (size_t)rows * cols * sizeof(float);
+
+  std::vector<float> h_in(rows * cols), h_out(rows * cols), h_ref(rows * cols);
+  srand(50);
+  for (auto& v : h_in)
+    v = scale * (static_cast<float>(rand()) / static_cast<float>(RAND_MAX));
+
+  printf("Allocate device buffers\n");
+  float *d_in = nullptr, *d_out = nullptr;
+  HIP_CHECK(hipMalloc((void**)&d_in, nbytes));
+  HIP_CHECK(hipMalloc((void**)&d_out, nbytes));
+
+  printf("Upload source buffer\n");
+  HIP_CHECK(hipMemcpy(d_in, h_in.data(), nbytes, hipMemcpyHostToDevice));
+
+  // One thread per row; the block is as large as the device allows.
+  int dev_id = 0;
+  HIP_CHECK(hipGetDevice(&dev_id));
+  hipDeviceProp_t dev_props{};
+  HIP_CHECK(hipGetDeviceProperties(&dev_props, dev_id));
+  uint32_t block_size = (uint32_t)dev_props.maxThreadsPerBlock;
+  if (block_size > rows)
+    block_size = rows;
+  uint32_t grid_size = (rows + block_size - 1) / block_size;
+  printf("Execute the kernel: grid=%u, block=%u (device max=%d)\n",
+         grid_size, block_size, dev_props.maxThreadsPerBlock);
+
+  // The first launch JIT-compiles the SPIR-V module (chipStar -> PoCL).
+  auto t0 = std::chrono::high_resolution_clock::now();
+  softmax<<<dim3(grid_size), dim3(block_size), 0, 0>>>(d_in, d_out, rows, cols);
+  HIP_CHECK(hipGetLastError());
+  HIP_CHECK(hipDeviceSynchronize());
+  auto t1 = std::chrono::high_resolution_clock::now();
+  printf("Elapsed time (JIT + kernel): %lld ms\n",
+         (long long)std::chrono::duration_cast<std::chrono::milliseconds>(t1 - t0).count());
+
+  printf("Download destination buffer\n");
+  HIP_CHECK(hipMemcpy(h_out.data(), d_out, nbytes, hipMemcpyDeviceToHost));
+
+  printf("Verify result\n");
+  softmax_cpu(h_ref.data(), h_in.data(), rows, cols);
+  int errors = 0;
+  double max_rel = 0.0;
+  for (uint32_t i = 0; i < rows * cols; ++i) {
+    double rel = std::fabs((double)h_out[i] - h_ref[i]) / std::fmax((double)h_ref[i], ABS_FLOOR);
+    if (!(rel <= REL_TOL)) {
+      if (errors < 100)
+        printf("*** error: [%u][%u] expected=%g, actual=%g\n", i / cols, i % cols, h_ref[i], h_out[i]);
+      ++errors;
+    }
+    if (rel > max_rel)
+      max_rel = rel;
+  }
+  printf("Max relative error: %.3g\n", max_rel);
+
+  HIP_CHECK(hipFree(d_in));
+  HIP_CHECK(hipFree(d_out));
+
+  if (errors == 0) {
+    printf("PASSED!\n");
+  } else {
+    printf("FAILED! - %d errors\n", errors);
+  }
+  return errors ? 1 : 0;
+}
